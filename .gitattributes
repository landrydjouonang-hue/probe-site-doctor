# The plugin is normalised to LF. Without this, Git on Windows checks files out
# as CRLF and Plugin Check reports "mixed line endings" on any zip built from a
# fresh clone.
* text=auto eol=lf

# Binary assets must never be line-ending converted.
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.webp binary
*.ico  binary
*.woff binary
*.woff2 binary
*.zip  binary

# Screenshots are generated from the running plugin, so keep them out of diffs
# and out of the repository's language statistics.
docs/screenshots/* linguist-generated=true
.wordpress-org/*   linguist-generated=true
